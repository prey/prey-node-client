#!/usr/bin/env bash
LC_ALL=C

local_branch="$(git rev-parse --abbrev-ref HEAD)"

valid_branch_regex="^(feat|fix|docs|style|refactor|perf|test|chore)\/[a-z0-9._-]+$"

message1="There is something wrong with your branch name."
message2="Branch names must start with one of these words: $valid_branch_regex"
message3="You should rename your branch using: git branch -m BRANCH-NAME"

if [[ ! $local_branch =~ $valid_branch_regex ]]
then
    echo "$message1"
    echo "$message2"
    echo "$message3"
    exit 1
fi

echo "Checking // @ts-check in staged lib/ files..."
missing_tscheck=()
while IFS= read -r file; do
  [ -f "$file" ] && ! head -5 "$file" | grep -q '// @ts-check' && missing_tscheck+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR | grep '^lib/.*\.js$')

if [ ${#missing_tscheck[@]} -gt 0 ]; then
  echo "The following staged lib/ files are missing '// @ts-check':"
  for f in "${missing_tscheck[@]}"; do
    echo "  $f"
  done
  echo "Add '// @ts-check' at the top of each file before committing."
  exit 1
fi

echo "Running typecheck..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "Typecheck failed. Fix type errors before committing."
  exit 1
fi

echo "Running tests..."
npm run test-sf
if [ $? -ne 0 ]; then
  echo "Tests failed. All tests must pass before committing."
  exit 1
fi

exit 0
