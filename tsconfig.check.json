{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["es2020"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.js", "test/**/*.js"]
}
